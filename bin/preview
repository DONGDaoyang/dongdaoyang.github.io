#!/usr/bin/env bash
# One-command live preview, independent of the host Ruby installation.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker Desktop is required for this preview command."
  echo "Alternatively, with the correct Ruby and gems:"
  echo "bundle exec jekyll serve --config _config.yml,_config.preview.yml --livereload"
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Please start Docker Desktop, wait for it to finish starting, and run this command again."
  exit 1
fi

case "${1:-start}" in
  start)
    echo "Local preview: http://localhost:4000/"
    echo "Save a page to rebuild and refresh automatically. Press Ctrl+C to stop."
    exec docker compose -f docker-compose.preview.yml up --build
    ;;
  stop)
    exec docker compose -f docker-compose.preview.yml down
    ;;
  *)
    echo "Usage: bash bin/preview [start|stop]"
    exit 1
    ;;
esac
