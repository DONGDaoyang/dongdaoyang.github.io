# Isolated local preview. Does not install Ruby or gems on the host Mac.
FROM ruby:3.3-slim

ENV DEBIAN_FRONTEND=noninteractive \
    EXECJS_RUNTIME=Node \
    JEKYLL_ENV=development \
    LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential ca-certificates git nodejs zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/jekyll
COPY Gemfile Gemfile.lock ./
RUN gem install --no-document bundler -v 4.0.6 && bundle install --jobs 4 --retry 3

EXPOSE 4000 35729
